{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "assets/js/**",
              "components/actions/**",
              "components/chrome/**",
              "components/content/**",
              "ui_kits/nhato-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Manrope|Ibarra Real Nova|Inter|Montserrat|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Manrope, Ibarra Real Nova, Inter, Montserrat, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Frame1731'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|href|className|style|key|ref|className|style|children)$/]",
        "message": "<Frame1731> doesn't accept that prop. Declared props: image, title, href, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Frame2144771281'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|date|excerpt|href|className|style|key|ref|className|style|children)$/]",
        "message": "<Frame2144771281> doesn't accept that prop. Declared props: image, title, date, excerpt, href, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Frame2144771605'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|date|chip|href|className|style|key|ref|className|style|children)$/]",
        "message": "<Frame2144771605> doesn't accept that prop. Declared props: image, title, date, chip, href, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Frame5'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|current|phone|logoSrc|social|scrolled|className|style|key|ref|className|style|children)$/]",
        "message": "<Frame5> doesn't accept that prop. Declared props: items, current, phone, logoSrc, social, scrolled, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:facebook|tiktok|youtube|x|arrow-right|arrow-down|menu|eye|calendar|clock|house|apartment|villa|office|commercial|listen|spark|build|schedule|handover)$/]",
        "message": "<Icon> name must be one of 'facebook' | 'tiktok' | 'youtube' | 'x' | 'arrow-right' | 'arrow-down' | 'menu' | 'eye' | 'calendar' | 'clock' | 'house' | 'apartment' | 'villa' | 'office' | 'commercial' | 'listen' | 'spark' | 'build' | 'schedule' | 'handover'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
