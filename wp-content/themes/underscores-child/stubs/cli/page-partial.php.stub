<?php
declare(strict_types=1);

if (!defined('ABSPATH')) {
    exit;
}

// Có Flexible Content `sections` → render từng layout (partials/sections/*).
// Không có → dùng dữ liệu core: tiêu đề + nội dung trang (KHÔNG tạo field heading/intro trùng core).
if (underscores_child_render_flexible_sections('sections', get_the_ID())) {
    return;
}
?>
<section class="{{PAGE_CLASS}}__content">
    <?php the_title('<h1 class="{{PAGE_CLASS}}__title">', '</h1>'); ?>
    <?php the_content(); ?>
</section>
